# Copia este archivo como .env y rellena los valores.
# Firebase: Consola de Firebase → Configuración del proyecto → Tus apps → Configuración del SDK
# (también están en Netlify → Site configuration → Environment variables)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# TMDB: themoviedb.org → Ajustes → API
VITE_TMDB_API_KEY=

# Notificaciones push (VAPID). Generar con: npx web-push generate-vapid-keys
# La pública va al frontend; la privada solo a la Netlify Function.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cuenta de servicio de Firebase (JSON en una sola línea), solo para la Netlify Function.
# Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada
FIREBASE_SERVICE_ACCOUNT=
